@page
@model AmuraWebsite.Pages.CareersModel
@{
    ViewData["Title"] = "Careers";
    ViewData["Description"] = "Careers at Amura Insurance Agency — internships and full-time roles in Nairobi.";
}

<section class="section">
    <div class="container">
        <span class="eyebrow">Careers</span>
        <h2 class="mt-3 mb-2" style="font-size:clamp(1.7rem,3vw,2.2rem); font-weight:600;">
            Build your career with Amura Insurance Agency.
        </h2>
        <p class="mb-5" style="max-width: 65ch;">
            We're growing our team in Nairobi. If you're passionate about helping people protect what matters, we'd love to hear from you.
        </p>
        <div class="row g-5">
            <div class="col-lg-6 reveal">
                <h3 style="font-size:1.4rem; font-weight:600;">Current Openings</h3>
                <p class="text-muted mb-4">We're looking for driven, client-focused people to join us in the following roles:</p>

                <div class="contact-card mb-4">
                    <h3 class="h5 mb-2">Intern</h3>
                    <p class="text-muted small mb-2">Location: Nairobi City Centre</p>
                    <ul class="mb-0">
                        <li>Rotations across Sales, Admin &amp; Customer Service</li>
                        <li>Learn our product lines (Medical, Motor, Travel, Domestic &amp; PI)</li>
                        <li>Support quotes, follow-ups and front-desk work</li>
                        <li>Strong written/spoken English &amp; good people skills</li>
                        <li>Commitment to learn and grow with the team</li>
                    </ul>
                </div>

                <div class="contact-card mb-4">
                    <h3 class="h5 mb-2">Sales Agent</h3>
                    <p class="text-muted small mb-2">Location: Nairobi City Centre</p>
                    <ul class="mb-0">
                        <li>Generate and follow up on leads for our product lines</li>
                        <li>Explain cover options clearly and help clients choose the right fit</li>
                        <li>Maintain client records and nurture relationships</li>
                        <li>Previous insurance experience an advantage (not mandatory)</li>
                    </ul>
                </div>

                <div class="contact-card mb-4">
                    <h3 class="h5 mb-2">Administrative Assistant</h3>
                    <p class="text-muted small mb-2">Location: Nairobi City Centre</p>
                    <ul class="mb-0">
                        <li>Front desk, email and phone coordination</li>
                        <li>Document management, filing and CRM updates</li>
                        <li>Support internal processes with precision and professionalism</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6 reveal">
                <h3 style="font-size:1.4rem; font-weight:600;">How to Apply</h3>
                <p class="text-muted mb-4">Send your application to <a href="mailto:info@amurainsurance.com">info@amurainsurance.com</a> with:</p>

                <div class="contact-card">
                    <ul>
                        <li>Subject line: "Application &mdash; [Role you're applying for]"</li>
                        <li>CV/Resume (PDF preferred)</li>
                        <li>A brief cover email introducing yourself</li>
                        <li>Preferred start date (if applicable)</li>
                    </ul>
                    <p class="mt-4 mb-0">
                        No phone calls before shortlisting, please. We'll get back to shortlisted candidates as soon as possible.
                    </p>
                </div>

                <div class="contact-card mt-4">
                    <h3 class="h5 mb-3">Our Culture</h3>
                    <p class="text-muted mb-0">
                        We believe in practical training, clear communication, and treating clients the way we'd want to be treated. You'll get the support you need to grow, learn and build a career in insurance.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container text-center">
        <h2 style="font-size:clamp(1.6rem,3vw,2.2rem); font-weight:600;">Don't see a perfect fit?</h2>
        <p class="mt-2 mb-4">We're always looking for great people. Send us your CV anyway — we'll keep it on file for future openings.</p>
        <a href="mailto:info@amurainsurance.com?subject=General%20Application%20-%20Amura%20Insurance%20Agency" class="btn btn-quote btn-lg">Send us your CV</a>
    </div>
</section>