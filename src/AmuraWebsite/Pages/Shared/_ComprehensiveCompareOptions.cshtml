@model AmuraWebsite.Pages.Quote.Motor.ComprehensiveQuoteModel

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Quote is not null && Model.Quote.Options.Count > 0)
{
    <section class="section" style="padding-top:0;">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-8 reveal">
                    <div class="contact-card">
                        <h3 style="font-size:1.15rem; font-weight:700; margin: 0 0 0.2rem;">Your prices</h3>
                        <p class="text-muted small mb-3">
                            @Model.Quote.Options.Count underwriter(s) compared for a vehicle valued at <strong>KES @Model.Input.VehicleValue.ToString("N0")</strong>. Pick an underwriter and tick any optional benefits, then continue to buy.
                        </p>

                        <form method="post" asp-page-handler="Continue" novalidate>
                            <input type="hidden" asp-for="Input.VehicleValue" />

                            @foreach (var option in Model.Quote.Options.OrderBy(p => p.TotalPremium))
                            {
                                var key = option.UnderwriterId.ToString();
                                var benefits = Model.Quote.BenefitsByUnderwriter.TryGetValue(key, out var uwBenefits)
                                    ? uwBenefits.OrderBy(b => b.DisplayOrder).ToList()
                                    : new List<AmuraWebsite.Services.ComprehensiveBenefitDto>();
                                var included = benefits.Where(b => b.IsIncludedInBase).ToList();
                                var addons = benefits.Where(b => !b.IsIncludedInBase).ToList();
                                var limits = Model.Quote.LiabilityLimitsByUnderwriter.TryGetValue(key, out var uwLimits)
                                    ? uwLimits.OrderBy(l => l.DisplayOrder).ToList()
                                    : new List<AmuraWebsite.Services.ComprehensiveLiabilityLimitDto>();
                                var baseTotal = option.BasePremium + option.PvtAmount;

                                <div class="mb-3" style="border:1px solid var(--line-on-light); border-radius: var(--radius-md); padding: 1.25rem;" data-underwriter-card="@option.UnderwriterId">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                                        <label class="form-check form-check-inline mb-0" style="cursor:pointer;">
                                            <input type="radio" name="SelectedUnderwriter" value="@option.UnderwriterId" class="form-check-input me-2" required />
                                            <strong>@option.UnderwriterName</strong>
                                        </label>
                                        <div style="font-size:1.5rem; font-weight:700; color: var(--gold-2);">
                                            <span data-total>KES @baseTotal.ToString("N0")</span>
                                            <span class="text-muted d-block" style="font-size:0.8rem; font-weight:500; text-align:right;">base + selected benefits</span>
                                        </div>
                                    </div>
                                    <div class="text-muted small mb-2">
                                        Base premium KES @option.BasePremium.ToString("N0") &middot; PVT KES @option.PvtAmount.ToString("N0") &middot; Rate @option.RatePercent.ToString("0.####")%
                                    </div>

                                    <input type="hidden" data-base-total="@baseTotal" />

                                    @if (included.Count > 0)
                                    {
                                        <div class="small mb-2"><strong>Included in base:</strong>
                                            @foreach (var b in included)
                                            {
                                                <span class="badge bg-success-subtle text-success-emphasis me-1">@b.BenefitName</span>
                                            }
                                        </div>
                                    }

                                    @if (addons.Count > 0)
                                    {
                                        <div class="small mb-1"><strong>Optional benefits (tick to add):</strong></div>
                                        <div class="row g-2 mb-2">
                                            @foreach (var b in addons)
                                            {
                                                var price = b.DefaultPrice;
                                                <div class="col-md-6">
                                                    <label class="d-flex align-items-center" style="border:1px solid var(--line-on-light); border-radius: var(--radius-sm, 10px); padding: 0.5rem 0.7rem; cursor:pointer;">
                                                        <input type="checkbox" name="SelectedBenefits" value="@(option.UnderwriterId + ":" + b.BenefitId)" class="form-check-input me-2 benefit-check" data-price="@price" @(price == 0 ? "disabled" : "") />
                                                        <span class="d-flex justify-content-between align-items-center flex-grow-1">
                                                            <span>
                                                                <span class="d-block" style="font-weight:600;">@b.BenefitName</span>
                                                                @if (!string.IsNullOrEmpty(b.Description))
                                                                {
                                                                    <span class="d-block text-muted" style="font-size:0.75rem;">@b.Description</span>
                                                                }
                                                            </span>
                                                            <span class="ms-2 text-nowrap" style="font-weight:600;">
                                                                @if (price > 0)
                                                                {
                                                                    <span>+KES @price.ToString("N0")</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-success">Free</span>
                                                                }
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (limits.Count > 0)
                                    {
                                        <details class="small text-muted mt-1">
                                            <summary>Coverage limits</summary>
                                            <ul class="mb-0 ps-3 mt-1">
                                                @foreach (var l in limits)
                                                {
                                                    <li><strong>@l.LimitName:</strong> @l.LimitValue</li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </div>
                            }

                            <div class="d-flex justify-content-end mt-3">
                                <button type="submit" class="btn btn-quote btn-lg">Continue to Buy &rarr;</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="col-lg-4 reveal">
                    <span class="eyebrow">Next steps</span>
                    <h2 class="mt-3 mb-3" style="font-size:1.3rem; font-weight:600;">Ready to buy?</h2>
                    <p class="text-muted">Pick the underwriter you like, tick any optional benefits, and continue to the purchase flow. We'll collect your details and set up payment by M-Pesa.</p>
                </div>
            </div>
        </div>
    </section>
}
else if (Model.Quote is not null)
{
    <section class="section" style="padding-top:0;">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-8 reveal">
                    <div class="contact-card">
                        <div class="alert alert-warning mb-0" role="alert">
                            No underwriter currently has a price for a vehicle valued at <strong>KES @Model.Input.VehicleValue.ToString("N0")</strong> — our partner rates start from about <strong>KES 500,000</strong>. Try a higher vehicle value.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}