<!DOCTYPE html>
<html lang="en">
@{
    var instaUrl = "https://www.instagram.com/amurainsuranceagency";
    var tiktokUrl = "https://www.tiktok.com/@amurainsuranceagency";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Amura Insurance Agency</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Amura Insurance Agency — trusted cover for individuals, families and businesses across Kenya.")" />

    <!-- Favicon -->
    <link rel="icon" href="~/images/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16.png" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />

    <!-- Fonts: Fraunces (display) + Inter (body/UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="site-header-group">
        <div class="top-strip">
            <div class="container">
                <div class="top-strip-contact">
                    <a href="tel:+254723242389">+254 723 242 389</a>
                    <a href="mailto:info@amurainsurance.com">info@amurainsurance.com</a>
                    <a href="https://maps.google.com/maps?q=Jubilee+Exchange+Nairobi&output=embed" target="_blank" rel="noopener">Jubilee Exchange, 1st Floor, Town</a>
                </div>
                <div class="top-strip-social">
                    <a href="@instaUrl" target="_blank" rel="noopener" aria-label="Instagram">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none" /></svg>
                    </a>
                    <a href="@tiktokUrl" target="_blank" rel="noopener" aria-label="TikTok">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743 2.895 2.895 0 0 1 3.183-4.51v-3.5a6.329 6.329 0 0 0-5.394 10.692 6.33 6.33 0 0 0 10.857-4.424V8.687a8.182 8.182 0 0 0 4.773 1.526V6.79a4.831 4.831 0 0 1-1.003-.104z" /></svg>
                    </a>
                </div>
            </div>
        </div>

        <header class="amura-header">
            <nav class="navbar navbar-expand-lg">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center" href="/">
                        <img src="~/images/logo-icon-nav.png" alt="" class="brand-icon" />
                        <span class="brand-mark">AMURA</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav mx-lg-auto align-items-lg-center gap-lg-1">
                            <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" asp-page="/Services">Services</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-page="/Quote/MedicalIndividual">Medical &mdash; Individual &amp; Family</a></li>
                                    <li><a class="dropdown-item" asp-page="/Quote/MedicalCorporate">Medical &mdash; Corporate</a></li>
                                    <li><a class="dropdown-item" asp-page="/Quote/ProfessionalIndemnity">Professional Indemnity</a></li>
                                    <li><a class="dropdown-item" asp-page="/Quote/Travel">Travel Insurance</a></li>
                                    <li><a class="dropdown-item" asp-page="/Quote/Domestic">Domestic Insurance</a></li>
                                    <li><a class="dropdown-item" asp-page="/Quote/Motor">Motor Insurance</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-page="/About">About</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Careers">Careers</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Contact">Contact</a></li>
                        </ul>
                        <div class="d-flex align-items-lg-center gap-3 mt-3 mt-lg-0">
                            <div class="header-phone d-none d-lg-flex">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                                <span class="header-phone-text">
                                    <small>Call us now</small>
                                    <strong>+254 723 242 389</strong>
                                </span>
                            </div>
                            <a class="btn btn-quote" asp-page="/Services">Get a Quote</a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    </div>

    <main>
        @RenderBody()
    </main>

    <footer class="amura-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center">
                        <img src="~/images/logo-icon-nav.png" alt="" class="brand-icon brand-icon-footer" />
                        <span class="brand-mark brand-mark-footer">AMURA</span>
                    </div>
                    <p class="footer-tagline">Cover you can trust, service you can feel.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-heading">Products</h6>
                    <ul class="footer-links">
                        <li><a asp-page="/Services">Medical</a></li>
                        <li><a asp-page="/Services">Motor</a></li>
                        <li><a asp-page="/Services">Travel</a></li>
                        <li><a asp-page="/Services">Domestic</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-heading">Company</h6>
                    <ul class="footer-links">
                        <li><a asp-page="/About">About</a></li>
                        <li><a asp-page="/Careers">Careers</a></li>
                        <li><a asp-page="/Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="footer-heading">Reach us</h6>
                    <p class="footer-contact">
                        Jubilee Exchange, 1st Floor<br />
                        Nairobi City Centre, Kenya<br />
                        <a href="tel:+254723242389">+254 723 242 389</a><br />
                        <a href="mailto:info@amurainsurance.com">info@amurainsurance.com</a>
                    </p>
                    <div class="footer-social">
                        <a href="@instaUrl" target="_blank" rel="noopener">Instagram</a>
                        <span class="footer-social-sep">/</span>
                        <a href="@tiktokUrl" target="_blank" rel="noopener">TikTok</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year Amura Insurance Agency. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
