<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Amura Insurance Agency</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Amura Insurance Agency — trusted cover for individuals, families and businesses across Kenya.")" />

    <!-- Favicon -->
    <link rel="icon" href="~/images/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16.png" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />

    <!-- Fonts: Fraunces (display) + Inter (body/UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="site-header-group">
        <div class="top-strip">
            <div class="container">
                <div class="top-strip-contact">
                    <a href="tel:+254712345678">+254 712 345 678</a>
                    <a href="mailto:hello@amura.co.ke">hello@amura.co.ke</a>
                </div>
                <div class="top-strip-social">
                    <a href="#" aria-label="Facebook">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.5 9.87v-6.98H7.9V12h2.6V9.8c0-2.57 1.49-3.99 3.83-3.99 1.11 0 2.27.2 2.27.2v2.5h-1.28c-1.26 0-1.65.78-1.65 1.58V12h2.81l-.45 2.89h-2.36v6.98A10 10 0 0 0 22 12z" /></svg>
                    </a>
                    <a href="#" aria-label="Twitter / X">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.83-5.97 6.83H1.65l7.73-8.84L1.24 2.25h6.83l4.72 6.24 5.45-6.24zm-1.16 17.52h1.83L7.02 4.13H5.06L17.08 19.77z" /></svg>
                    </a>
                    <a href="#" aria-label="Instagram">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none" /></svg>
                    </a>
                </div>
            </div>
        </div>

        <header class="amura-header">
            <nav class="navbar navbar-expand-lg">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center" href="/">
                        <img src="~/images/logo-icon-nav.png" alt="" class="brand-icon" />
                        <span class="brand-mark">AMURA</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav mx-lg-auto align-items-lg-center gap-lg-1">
                            <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Services">Services</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/About">About</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Services" asp-fragment="how-it-works">How It Works</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Contact">Contact</a></li>
                        </ul>
                        <div class="d-flex align-items-lg-center gap-3 mt-3 mt-lg-0">
                            <div class="header-phone d-none d-lg-flex">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                                <span class="header-phone-text">
                                    <small>Call us now</small>
                                    <strong>+254 712 345 678</strong>
                                </span>
                            </div>
                            <a class="btn btn-quote" asp-page="/Services">Get a Quote</a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    </div>

    <main>
        @RenderBody()
    </main>

    <footer class="amura-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center">
                        <img src="~/images/logo-icon-nav.png" alt="" class="brand-icon brand-icon-footer" />
                        <span class="brand-mark brand-mark-footer">AMURA</span>
                    </div>
                    <p class="footer-tagline">Cover you can trust, service you can feel.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-heading">Products</h6>
                    <ul class="footer-links">
                        <li><a asp-page="/Services">Medical</a></li>
                        <li><a asp-page="/Services">Motor</a></li>
                        <li><a asp-page="/Services">Travel</a></li>
                        <li><a asp-page="/Services">Domestic</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-heading">Company</h6>
                    <ul class="footer-links">
                        <li><a asp-page="/About">About</a></li>
                        <li><a asp-page="/Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="footer-heading">Reach us</h6>
                    <p class="footer-contact">Nairobi, Kenya<br />hello@amura.co.ke</p>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year Amura Insurance Agency. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
