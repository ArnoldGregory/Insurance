@page
@model AmuraWebsite.Pages.Quote.MotorModel
@{
    ViewData["Title"] = "Motor Insurance Quote";
    ViewData["Description"] = "Get a motor insurance quote from Amura Insurance Agency — Third Party Only or Comprehensive cover.";
}

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8 reveal">
                <div class="contact-card">
                    <h3 style="font-size:1.15rem; font-weight:700; margin: 0 0 0.2rem;">Motor Insurance</h3>
                    <p class="text-muted small mb-3">Choose the cover type that fits, then we'll pull live prices from our underwriter partners.</p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div style="border:1px solid var(--line-on-light); border-radius: var(--radius-md); padding: 1.5rem; height:100%; display:flex; flex-direction:column;">
                                <h4 style="font-size:1.05rem; font-weight:700;">Third Party Only (TPO)</h4>
                                <p class="text-muted small flex-grow-1">Covers damage you cause to others — the most affordable option. Compare live prices and buy online.</p>
                                <a class="btn btn-quote mt-3" asp-page="/Quote/Motor/Details">Get TPO quote &rarr;</a>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div style="border:1px solid var(--line-on-light); border-radius: var(--radius-md); padding: 1.5rem; height:100%; display:flex; flex-direction:column;">
                                <h4 style="font-size:1.05rem; font-weight:700;">Comprehensive</h4>
                                <p class="text-muted small flex-grow-1">Full cover including your own vehicle, plus optional benefits. Compare live prices across underwriters.</p>
                                <a class="btn btn-quote mt-3" asp-page="/Quote/Motor/ComprehensiveQuote">Get Comprehensive quote &rarr;</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 reveal">
                <span class="eyebrow">What's covered</span>
                <h2 class="mt-3 mb-4" style="font-size:1.5rem; font-weight:600;">Motor insurance</h2>
                <p class="text-muted">Comprehensive or third-party cover for your vehicle, arranged through our licensed insurer partners.</p>
            </div>
        </div>
    </div>
</section>
