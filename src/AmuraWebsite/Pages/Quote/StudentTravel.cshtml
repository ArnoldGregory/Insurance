@page
@model AmuraWebsite.Pages.Quote.StudentTravelModel
@{
    ViewData["Title"] = "Student Travel Insurance Quote";
    ViewData["Description"] = "Get travel insurance for a student trip — study, exchange or school travel — from Amura Insurance Agency.";
}

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7 reveal">
                <div class="contact-card">

                    @if (Model.Submitted)
                    {
                        <div class="alert alert-success" role="alert">
                            Thanks — your student travel quote request has been received@(string.IsNullOrEmpty(Model.ReferenceNumber) ? "." : $" (ref. {Model.ReferenceNumber}).") We'll be in touch shortly.
                        </div>
                    }

                    <form method="post" novalidate>
                        <input type="hidden" asp-for="FormToken" />
                        <div style="position:absolute; left:-9999px; opacity:0;" aria-hidden="true">
                            <label for="Input_Website">Leave this field blank</label>
                            <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
                        </div>
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FullName" class="form-label"></label>
                                <input asp-for="Input.FullName" class="form-control" placeholder="Jane Wanjiku" />
                                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.IdNo" class="form-label"></label>
                                <input asp-for="Input.IdNo" class="form-control" placeholder="e.g. 33333333" />
                                <span asp-validation-for="Input.IdNo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Email" class="form-label">Email</label>
                                <input asp-for="Input.Email" class="form-control" placeholder="jane@example.com" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Phone" class="form-label">Phone</label>
                                <input asp-for="Input.Phone" class="form-control" placeholder="07xx xxx xxx" />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.DateOfBirth" class="form-label"></label>
                                <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="Input.DateOfBirth" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Institution" class="form-label"></label>
                                <input asp-for="Input.Institution" class="form-control" placeholder="School / university" />
                                <span asp-validation-for="Input.Institution" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Destination" class="form-label"></label>
                                <input asp-for="Input.Destination" class="form-control" placeholder="e.g. UK, Mombasa" />
                                <span asp-validation-for="Input.Destination" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.DepartureDate" class="form-label"></label>
                                <input asp-for="Input.DepartureDate" class="form-control" type="date" />
                                <span asp-validation-for="Input.DepartureDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.ReturnDate" class="form-label"></label>
                                <input asp-for="Input.ReturnDate" class="form-control" type="date" />
                                <span asp-validation-for="Input.ReturnDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-quote btn-lg mt-4">Get my quote</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-5 reveal">
                <span class="eyebrow">What's covered</span>
                <h2 class="mt-3 mb-4" style="font-size:1.5rem; font-weight:600;">Student travel</h2>
                <p class="text-muted">Cover for a student's study, exchange or school trip — medical emergencies, trip cancellation, baggage and delays.</p>
            </div>
        </div>
    </div>
</section>
