@page
@model AmuraWebsite.Pages.Quote.ProfessionalIndemnityModel
@{
    ViewData["Title"] = "Professional Indemnity Quote";
    ViewData["Description"] = "Get a quote for professional indemnity cover from Amura Insurance Agency.";
}

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7 reveal">
                <div class="contact-card">
                    <form method="post" novalidate>
                        <input type="hidden" asp-for="FormToken" />
                        <div style="position:absolute; left:-9999px; opacity:0;" aria-hidden="true">
                            <label for="Input_Website">Leave this field blank</label>
                            <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
                        </div>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FullName" class="form-label">Full name</label>
                                <input asp-for="Input.FullName" class="form-control" placeholder="Jane Wanjiku" />
                                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.IdNo" class="form-label">National ID / Passport number</label>
                                <input asp-for="Input.IdNo" class="form-control" placeholder="e.g. 33333333" />
                                <span asp-validation-for="Input.IdNo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Phone" class="form-label">Phone</label>
                                <input asp-for="Input.Phone" class="form-control" placeholder="07xx xxx xxx" />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Email" class="form-label">Email</label>
                                <input asp-for="Input.Email" class="form-control" placeholder="jane@example.com" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Input.Profession" class="form-label">Profession / industry</label>
                                <input asp-for="Input.Profession" class="form-control" placeholder="e.g. Architect, Consultant, Accountant" />
                                <span asp-validation-for="Input.Profession" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.YearsInPractice" class="form-label">Years in practice</label>
                                <input asp-for="Input.YearsInPractice" class="form-control" type="number" min="0" max="60" />
                                <span asp-validation-for="Input.YearsInPractice" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-quote btn-lg mt-4">Continue to proposal form &rarr;</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-5 reveal">
                <span class="eyebrow">What's covered</span>
                <h2 class="mt-3 mb-4" style="font-size:1.5rem; font-weight:600;">Professional Indemnity</h2>
                <p class="text-muted">Cover against claims of negligence or error in the professional advice or services you provide to clients.</p>
            </div>
        </div>
    </div>
</section>