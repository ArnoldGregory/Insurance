@page
@model AmuraWebsite.Pages.Quote.Motor.CertificateModel
@{
    ViewData["Title"] = "Your Insurance Certificate";
    var cert = Model.Certificate;
    var ready = cert is not null && cert.PaymentStatus == "PAID" && cert.CertificateStatus == "GENERATED";
    var waitingPayment = cert is not null && cert.PaymentStatus != "PAID";
    var generating = cert is not null && cert.PaymentStatus == "PAID" && cert.CertificateStatus != "GENERATED";
}
<style>
    .cert-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
    .cert-sheet { background: #fff; max-width: 820px; margin: 0 auto; border: 2px solid #d4af37; border-radius: 10px; padding: 36px 40px; position: relative; color: #111827; }
    .cert-sheet::before { content: ''; position: absolute; inset: 8px; border: 1px solid #e5e7eb; border-radius: 6px; pointer-events: none; }
    .cert-header { text-align: center; padding-bottom: 20px; border-bottom: 2px solid #d4af37; margin-bottom: 22px; }
    .cert-brand { font-size: 20px; font-weight: 800; letter-spacing: 1px; color: #d4af37; }
    .cert-title { font-size: 15px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: #4b5563; margin-top: 4px; }
    .cert-no-row { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; align-items: baseline; }
    .cert-no-box { font-family: monospace; font-size: 15px; font-weight: 700; background: #faf9ef; border: 1px dashed #d4af37; padding: 8px 14px; border-radius: 6px; }
    .cert-issued { font-size: 12px; color: #6b7280; }
    .cert-section-title { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: #9ca3af; margin: 18px 0 8px; }
    .cert-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 4px 24px; }
    .cert-item { padding: 8px 0; border-bottom: 1px solid #f3f4f6; }
    .cert-label { font-size: 10px; text-transform: uppercase; letter-spacing: .5px; color: #9ca3af; margin-bottom: 2px; }
    .cert-value { font-size: 14px; font-weight: 600; color: #111827; }
    .cert-value.gold { color: #b8860b; font-size: 18px; }
    .cert-hr { border: 0; border-top: 1px solid #e5e7eb; margin: 18px 0; }
    .cert-footer { margin-top: 24px; padding-top: 16px; border-top: 2px solid #d4af37; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 11px; color: #6b7280; }
    .cert-stamp { font-style: italic; color: #9ca3af; }
    @@media print {
        body * { visibility: hidden; }
        .print-area, .print-area * { visibility: visible; }
        .print-area { position: absolute; left: 0; top: 0; width: 100%; }
        .cert-sheet { border-color: #000; box-shadow: none; max-width: 100%; }
        .cert-sheet::before { border-color: #9ca3af; }
        .cert-brand { color: #000; }
    }
</style>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8 reveal">
                <div class="contact-card">
                    <h3 style="font-size:1.15rem; font-weight:700; margin: 0 0 0.2rem;">Your Certificate</h3>
                    <p class="text-muted small mb-3">Retrieve your insurance certificate after paying, without logging in.</p>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                    }

                    @if (cert is null)
                    {
                        <form method="post" novalidate class="mb-3">
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Input.PolicyNumber" class="form-label">Policy number</label>
                                    <input asp-for="Input.PolicyNumber" class="form-control" placeholder="e.g. MOT-2451" />
                                    <span asp-validation-for="Input.PolicyNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Phone" class="form-label">Phone number used to pay</label>
                                    <input asp-for="Input.Phone" class="form-control" placeholder="07xx xxx xxx" />
                                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-quote btn-lg">Find My Certificate</button>
                                </div>
                            </div>
                        </form>
                    }
                    else if (waitingPayment)
                    {
                        <div class="alert alert-info" role="alert">
                            <strong>Payment not confirmed yet.</strong> We're waiting for your M-Pesa payment for policy
                            <strong>@cert.PolicyNumber</strong>. Once the payment is confirmed, your certificate will appear here —
                            check again in a few minutes.
                        </div>
                        <form method="post" class="mb-3">
                            <input type="hidden" asp-for="Input.PolicyNumber" value="@cert.PolicyNumber" />
                            <input type="hidden" asp-for="Input.Phone" value="@cert.ClientPhone" />
                            <button type="submit" class="btn btn-quote btn-lg">Check Again</button>
                        </form>
                    }
                    else if (generating)
                    {
                        <div class="alert alert-info" role="alert">
                            <strong>Payment received.</strong> Your certificate for policy <strong>@cert.PolicyNumber</strong> is being
                            prepared right now — check again in a few minutes.
                        </div>
                        <form method="post" class="mb-3">
                            <input type="hidden" asp-for="Input.PolicyNumber" value="@cert.PolicyNumber" />
                            <input type="hidden" asp-for="Input.Phone" value="@cert.ClientPhone" />
                            <button type="submit" class="btn btn-quote btn-lg">Check Again</button>
                        </form>
                    }
                    else if (ready)
                    {
                        <div class="cert-toolbar">
                            <span class="text-muted small">Policy @cert.PolicyNumber</span>
                            <button type="button" class="btn btn-quote" onclick="window.print()">Print / Save PDF</button>
                        </div>

                        <div class="print-area">
                            <div class="cert-sheet">
                                <div class="cert-header">
                                    <div class="cert-brand">Amura Insurance Agency</div>
                                    <div class="cert-title">Insurance Certificate</div>
                                </div>

                                <div class="cert-no-row">
                                    <div>
                                        <div class="cert-label">Certificate Number</div>
                                        <div class="cert-no-box">@(cert.CertificateNumber ?? "—")</div>
                                    </div>
                                    <div>
                                        <div class="cert-label">Official NTSA Certificate No.</div>
                                        <div class="cert-no-box">@(cert.NtsaCertificateNo ?? "—")</div>
                                    </div>
                                    <div class="cert-issued">
                                        Issued @(cert.CertificateGeneratedOn?.ToString("dd MMM yyyy, HH:mm") ?? "—")<br />
                                        Payment status: <strong>@cert.PaymentStatus</strong>
                                    </div>
                                </div>

                                <div class="cert-section-title">Insured</div>
                                <div class="cert-grid">
                                    <div class="cert-item"><div class="cert-label">Full name</div><div class="cert-value">@(cert.ClientName ?? "—")</div></div>
                                    <div class="cert-item"><div class="cert-label">ID / Passport No.</div><div class="cert-value">@(cert.ClientIdNo ?? "—")</div></div>
                                    <div class="cert-item"><div class="cert-label">Phone</div><div class="cert-value">@(cert.ClientPhone ?? "—")</div></div>
                                    <div class="cert-item"><div class="cert-label">Email</div><div class="cert-value">@(cert.ClientEmail ?? "—")</div></div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(cert.VehicleRegNo))
                                {
                                    <div class="cert-section-title">Insured Vehicle</div>
                                    <div class="cert-grid">
                                        <div class="cert-item"><div class="cert-label">Registration No.</div><div class="cert-value" style="font-family:monospace;">@cert.VehicleRegNo</div></div>
                                        <div class="cert-item"><div class="cert-label">Make / Model</div><div class="cert-value">@($"{cert.VehicleMake} {cert.VehicleModel}".Trim())</div></div>
                                        @if (cert.VehicleSnapshot?.VehicleValue is not null)
                                        {
                                            <div class="cert-item"><div class="cert-label">Vehicle Value</div><div class="cert-value">@cert.VehicleSnapshot.VehicleValue.Value.ToString("N0")</div></div>
                                        }
                                        @if (cert.VehicleSnapshot?.LicensedToCarry is not null)
                                        {
                                            <div class="cert-item"><div class="cert-label">Licensed To Carry</div><div class="cert-value">@cert.VehicleSnapshot.LicensedToCarry</div></div>
                                        }
                                    </div>
                                }

                                <hr class="cert-hr" />

                                <div class="cert-section-title">Policy Details</div>
                                <div class="cert-grid">
                                    <div class="cert-item"><div class="cert-label">Policy Number</div><div class="cert-value" style="font-family:monospace;">@(cert.PolicyNumber ?? "—")</div></div>
                                    <div class="cert-item"><div class="cert-label">Product</div><div class="cert-value">@(cert.ProductName ?? "—")</div></div>
                                    <div class="cert-item"><div class="cert-label">Underwriter</div><div class="cert-value">@(cert.UnderwriterName ?? "—")</div></div>
                                    <div class="cert-item"><div class="cert-label">Period</div><div class="cert-value">@cert.PeriodName</div></div>
                                    <div class="cert-item"><div class="cert-label">Cover Start</div><div class="cert-value">@cert.StartDate.ToString("dd MMM yyyy")</div></div>
                                    <div class="cert-item"><div class="cert-label">Cover End</div><div class="cert-value">@cert.EndDate.ToString("dd MMM yyyy")</div></div>
                                    <div class="cert-item"><div class="cert-label">Premium Paid</div><div class="cert-value gold">KES @cert.PremiumAmount.ToString("N2")</div></div>
                                    <div class="cert-item"><div class="cert-label">Purchase Ref</div><div class="cert-value">#@cert.PurchaseId</div></div>
                                </div>

                                <div class="cert-footer">
                                    <span>This certificate confirms the insurance cover described above and is issued subject to the policy terms, conditions and exclusions.</span>
                                    <span class="cert-stamp">Issued by Amura Insurance Agency</span>
                                </div>
                            </div>
                        </div>

                        <p class="text-muted small mt-4">
                            Looking for a different policy? <a asp-page="Certificate">Look up another certificate</a>.
                        </p>
                    }
                </div>
            </div>

            <div class="col-lg-4 reveal">
                <span class="eyebrow">Self-service</span>
                <h2 class="mt-3 mb-3" style="font-size:1.3rem; font-weight:600;">Certificate on demand</h2>
                <p class="text-muted">Your certificate is available here as soon as your payment is confirmed — printable or saved as PDF.</p>
                <p class="text-muted small">No login needed: just your policy number and the phone number you paid with.</p>
            </div>
        </div>
    </div>
</section>