@page
@model AmuraWebsite.Pages.Quote.Motor.ComprehensiveQuoteModel
@{
    ViewData["Title"] = "Comprehensive Motor Insurance — Get a Quote";
    ViewData["Description"] = "Compare live comprehensive motor insurance prices from Amura Insurance Agency's underwriter partners, and add optional benefits.";
}

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8 reveal">
                <div class="contact-card">
                    <h3 style="font-size:1.15rem; font-weight:700; margin: 0 0 0.2rem;">Comprehensive Motor Quote</h3>
                    <p class="text-muted small mb-3">Enter your vehicle's value and we'll compare live prices from our underwriter partners.</p>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                    }

                    <form method="post" novalidate>
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Input.VehicleValue" class="form-label">Vehicle value (KES)</label>
                                <input asp-for="Input.VehicleValue" id="quote-vehicle-value" class="form-control" type="number" min="500000" step="1000" placeholder="e.g. 1500000" />
                                <span asp-validation-for="Input.VehicleValue" class="text-danger small"></span>
                                <span class="text-muted small">The current market/insured value of your vehicle.</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-quote btn-lg">Get My Quote &rarr;</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4 reveal">
                <span class="eyebrow">Comprehensive cover</span>
                <h2 class="mt-3 mb-4" style="font-size:1.5rem; font-weight:600;">Full protection</h2>
                <p class="text-muted">Covers damage to your own vehicle as well as third-party liability. Start with the base premium, then tick optional benefits to build richer cover.</p>
            </div>
        </div>
    </div>
</section>

<div id="quote-preview">
    @if (Model.Quote is not null)
    {
        @await Html.PartialAsync("_ComprehensiveCompareOptions", Model)
    }
</div>

@section Scripts {
    <script>
        var previewRoot = document.getElementById('quote-preview');
        var vehicleInput = document.getElementById('quote-vehicle-value');

        function initBenefitCards(root) {
            if (!root) return;
            root.querySelectorAll('[data-underwriter-card]').forEach(function (card) {
                var baseTotalEl = card.querySelector('[data-base-total]');
                if (!baseTotalEl) return;
                var baseTotal = parseFloat(baseTotalEl.getAttribute('data-base-total'));
                var totalEl = card.querySelector('[data-total]');
                var checks = card.querySelectorAll('.benefit-check:not([disabled])');

                var refresh = function () {
                    var sum = baseTotal;
                    checks.forEach(function (chk) {
                        if (chk.checked) {
                            sum += parseFloat(chk.getAttribute('data-price'));
                        }
                    });
                    if (totalEl) {
                        totalEl.textContent = 'KES ' + sum.toLocaleString('en-KE', { minimumFractionDigits: 0 });
                    }
                };

                checks.forEach(function (chk) {
                    chk.addEventListener('change', refresh);
                });

                var cardRadio = card.querySelector('input[type="radio"]');
                if (cardRadio) {
                    cardRadio.addEventListener('change', function () {
                        root.querySelectorAll('[data-underwriter-card]').forEach(function (c) {
                            c.style.borderColor = '';
                        });
                        card.style.borderColor = 'var(--gold-2)';
                    });
                }
            });
        }

        function loadPreview() {
            if (!previewRoot || !vehicleInput) return;
            var raw = vehicleInput.value;
            var value = parseFloat(raw);
            if (!value || value <= 0) {
                previewRoot.innerHTML = '';
                return;
            }

            var url = window.location.pathname + '?handler=Preview&vehicleValue=' + encodeURIComponent(value);
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { if (!r.ok) throw new Error(String(r.status)); return r.text(); })
                .then(function (html) {
                    previewRoot.innerHTML = html;
                    initBenefitCards(previewRoot);
                    window.dispatchEvent(new Event('resize'));
                })
                .catch(function () {
                    previewRoot.innerHTML = '<div class="alert alert-warning" role="alert">Could not load prices right now — please use &ldquo;Get My Quote&rdquo;.</div>';
                });
        }

        var debounceTimer = null;
        if (vehicleInput) {
            vehicleInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(loadPreview, 350);
            });
        }
        initBenefitCards(document);
    </script>
}