@page
@model AmuraWebsite.Pages.Quote.PensionModel
@{
    ViewData["Title"] = "Pension Plan Quote";
    ViewData["Description"] = "Get a personal or employer pension plan quote from Amura Insurance Agency.";
}

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7 reveal">
                <div class="contact-card">

                    @if (Model.Submitted)
                    {
                        <div class="alert alert-success" role="alert">
                            Thanks — your pension quote request has been received@(string.IsNullOrEmpty(Model.ReferenceNumber) ? "." : $" (ref. {Model.ReferenceNumber}).") We'll be in touch shortly.
                        </div>
                    }

                    <form method="post" novalidate>
                        <input type="hidden" asp-for="FormToken" />
                        <div style="position:absolute; left:-9999px; opacity:0;" aria-hidden="true">
                            <label for="Input_Website">Leave this field blank</label>
                            <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
                        </div>
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FullName" class="form-label"></label>
                                <input asp-for="Input.FullName" class="form-control" placeholder="Jane Wanjiku" />
                                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.IdNo" class="form-label"></label>
                                <input asp-for="Input.IdNo" class="form-control" placeholder="e.g. 33333333" />
                                <span asp-validation-for="Input.IdNo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Email" class="form-label">Email</label>
                                <input asp-for="Input.Email" class="form-control" placeholder="jane@example.com" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Phone" class="form-label">Phone</label>
                                <input asp-for="Input.Phone" class="form-control" placeholder="07xx xxx xxx" />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Employer" class="form-label"></label>
                                <input asp-for="Input.Employer" class="form-control" placeholder="Employer name" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.PreferredRetirementAge" class="form-label"></label>
                                <input asp-for="Input.PreferredRetirementAge" class="form-control" type="number" min="18" max="75" />
                                <span asp-validation-for="Input.PreferredRetirementAge" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.MonthlyContribution" class="form-label"></label>
                                <input asp-for="Input.MonthlyContribution" class="form-control" placeholder="e.g. KES 5,000" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-quote btn-lg mt-4">Get my quote</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-5 reveal">
                <span class="eyebrow">What's covered</span>
                <h2 class="mt-3 mb-4" style="font-size:1.5rem; font-weight:600;">Pension plans</h2>
                <p class="text-muted">Build a retirement fund with a personal or employer-sponsored pension plan, structured around your income and retirement age.</p>
            </div>
        </div>
    </div>
</section>
