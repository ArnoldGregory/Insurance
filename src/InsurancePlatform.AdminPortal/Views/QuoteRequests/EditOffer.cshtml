@model EditQuoteOfferViewModel
@{
    ViewData["Title"] = "Edit Offer";
    var underwriterOptions = ViewBag.UnderwriterOptions as List<UnderwriterOption> ?? new List<UnderwriterOption>();
}
@section PageStyles {
    <link href="~/assets/static/plugins/select2/dist/css/select2.min.css" rel="stylesheet" />
}

<!-- begin page-header -->
<h1 class="page-header"><i class="fas fa-pencil-alt"></i> Edit Offer <small>Quote Request #@Model.QuoteRequestId</small></h1>
<!-- end page-header -->

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="panel panel-inverse" style="max-width:520px;">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a asp-action="Details" asp-route-id="@Model.QuoteRequestId" class="btn btn-xs btn-icon btn-circle btn-default"><i class="fa fa-arrow-left"></i></a>
        </div>
        <h4 class="panel-title">Offer details</h4>
    </div>
    <div class="panel-body">
        <form asp-action="EditOffer" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="QuoteOfferId" />
            <input type="hidden" asp-for="QuoteRequestId" />

            <div class="form-group">
                <label class="form-control-label">Underwriter</label>
                <select asp-for="UnderwriterId" class="form-control select2" style="width:100%;">
                    @foreach (var u in underwriterOptions)
                    {
                        <option value="@u.UnderwriterId" selected="@(Model.UnderwriterId == u.UnderwriterId)">@u.Name (@u.Code)</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-control-label">Premium amount</label>
                <input asp-for="PremiumAmount" type="number" step="0.01" min="0.01" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-control-label">Replace document (optional)</label>
                <input type="file" name="Document" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                <span class="help-block">Leave empty to keep the current document.</span>
            </div>

            <div style="display:flex;gap:10px;margin-top:6px;">
                <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save changes</button>
                <a asp-action="Details" asp-route-id="@Model.QuoteRequestId" class="btn btn-default">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section PageScripts {
    <script src="~/assets/static/plugins/select2/dist/js/select2.min.js"></script>
    <script>$(function () { $('.select2').select2(); });</script>
}
