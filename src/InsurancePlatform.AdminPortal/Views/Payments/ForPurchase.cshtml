@model PaymentsForPurchaseViewModel
@{
    ViewData["Title"] = $"Payments for Purchase #{Model.PurchaseId}";
}

<!-- begin page-header -->
<h1 class="page-header"><i class="fas fa-money-bill-wave"></i> Payments for Purchase #@Model.PurchaseId <small>Most recent attempt first. A payment marked SUCCESS also flips the purchase's payment status to PAID.</small></h1>
<!-- end page-header -->

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
}

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a asp-controller="Purchases" asp-action="Details" asp-route-id="@Model.PurchaseId" class="btn btn-xs btn-icon btn-circle btn-default"><i class="fa fa-arrow-left"></i></a>
            <a asp-action="Index" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-search"></i></a>
        </div>
        <h4 class="panel-title">Payment attempts</h4>
    </div>
    <div class="panel-body">
        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No payment attempts yet - nothing has been recorded against purchase #@Model.PurchaseId.</p>
        }
        else
        {
            <table class="table table-striped table-hover table-bordered table-condensed">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Payer phone</th>
                        <th>Transaction ref</th>
                        <th>Status</th>
                        <th>Initiated</th>
                        <th>Completed</th>
                        @if (Model.CanUpdateStatus)
                        {
                            <th style="width:260px;">Update status</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Items)
                    {
                        var badge = payment.Status switch
                        {
                            "SUCCESS" => "label-success",
                            "FAILED" => "label-danger",
                            _ => "label-warning"
                        };
                        <tr>
                            <td>#@payment.PaymentId</td>
                            <td>@payment.Amount.ToString("N2")</td>
                            <td>@payment.Method</td>
                            <td>@(payment.PayerPhone ?? "—")</td>
                            <td>@(payment.TransactionReference ?? "—")</td>
                            <td><span class="label @badge">@payment.Status</span></td>
                            <td>@payment.InitiatedOn.ToString("dd MMM yyyy, HH:mm")</td>
                            <td>@(payment.CompletedOn?.ToString("dd MMM yyyy, HH:mm") ?? "—")</td>
                            @if (Model.CanUpdateStatus)
                            {
                                <td>
                                    <form asp-action="UpdateStatus" method="post" class="form-inline" style="display:flex;gap:6px;">
                                        <input type="hidden" name="PaymentId" value="@payment.PaymentId" />
                                        <input type="hidden" name="PurchaseId" value="@Model.PurchaseId" />
                                        <select name="Status" class="form-control" style="min-width:100px;">
                                            @foreach (var s in PaymentsForPurchaseViewModel.StatusOptions)
                                            {
                                                <option value="@s" selected="@(payment.Status == s)">@s</option>
                                            }
                                        </select>
                                        <input type="text" name="TransactionReference" class="form-control" placeholder="ref" value="@payment.TransactionReference" style="min-width:90px;" />
                                        <button type="submit" class="btn btn-default btn-xs">Save</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <!-- end panel-body -->
</div>
<!-- end panel -->
