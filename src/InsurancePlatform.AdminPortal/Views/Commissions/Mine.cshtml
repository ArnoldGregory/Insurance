@model MyCommissionsViewModel
@{
    ViewData["Title"] = "My Commissions";
}

<!-- begin page-header -->
<h1 class="page-header">
    <i class="fas fa-wallet"></i> My Commissions
    <small>Your commission earnings, withdrawals and balance</small>
</h1>
<!-- end page-header -->

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
}

<div class="row m-b-15">
    <div class="col-md-6">
        <div class="panel panel-inverse">
            <div class="panel-body" style="text-align:center;padding:24px;">
                <div style="font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;">Available balance</div>
                <div style="font-size:36px;font-weight:800;color:#b8960f;line-height:1.3;">@Model.Balance.ToString("N2")</div>
                @if (Model.CanRequestWithdrawal)
                {
                    <form asp-action="RequestWithdrawal" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning" style="margin-top:8px;" onclick="return confirm('Request withdrawal of your full available balance?')"><i class="fa fa-money-bill-wave"></i> Request Withdrawal</button>
                    </form>
                }
                else
                {
                    <small class="text-muted">Request a withdrawal once your balance is above zero.</small>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel panel-inverse">
            <div class="panel-heading"><h4 class="panel-title">Your withdrawals</h4></div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-bordered table-condensed">
                        <thead>
                            <tr><th>ID</th><th>Amount</th><th>Status</th><th>Requested</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var w in Model.Withdrawals.OrderByDescending(w => w.RequestedOn).Take(10))
                            {
                                var badge = w.Status switch
                                {
                                    "APPROVED" => "label-success",
                                    "PAID" => "label-info",
                                    "REJECTED" => "label-danger",
                                    _ => "label-warning"
                                };
                                <tr>
                                    <td>#@w.WithdrawalId</td>
                                    <td>@w.Amount.ToString("N2")</td>
                                    <td><span class="label @badge">@w.Status</span></td>
                                    <td>@w.RequestedOn.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                            @if (Model.Withdrawals.Count == 0)
                            {
                                <tr><td colspan="4"><p class="text-muted" style="margin:0;">No withdrawals yet.</p></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <h4 class="panel-title">Commission ledger (@Model.Ledger.TotalCount total)</h4>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered table-condensed">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Purchase</th>
                        <th>Policy No.</th>
                        <th>Rate %</th>
                        <th>Cover Amount</th>
                        <th>Commission</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Ledger.Items)
                    {
                        var badge = c.Status == "WITHDRAWN" ? "label-info" : "label-success";
                        <tr>
                            <td>#@c.CommissionId</td>
                            <td>#@c.PurchaseId</td>
                            <td>@(c.PolicyNumber ?? "—")</td>
                            <td>@c.RatePercentApplied.ToString("N2")%</td>
                            <td>@c.CoverAmount.ToString("N2")</td>
                            <td><strong>@c.CommissionAmount.ToString("N2")</strong></td>
                            <td><span class="label @badge">@c.Status</span></td>
                            <td>@c.CreatedOn.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                    @if (Model.Ledger.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8"><p class="text-muted" style="margin:0;">No commissions yet. Sell policies to earn.</p></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- end panel-body -->
</div>
<!-- end panel -->