@model MenuIndexViewModel
@{
    ViewData["Title"] = "Menu Management";
}

<!-- begin page-header -->
<h1 class="page-header"><i class="fas fa-bars"></i> Menu Management <small>Add/edit sidebar items and control which roles can see each one. This only changes what shows in the sidebar - the API enforces its own permissions independently, regardless of what's granted here.</small></h1>
<!-- end page-header -->

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
}

<!-- This is a flat parent-then-children list where row ORDER carries
     meaning (a child must stay directly under its parent) and each row also
     hosts a small grid of role-access toggle buttons plus row actions - a
     jQuery DataTable's client-side sort would scramble the parent/child
     grouping and doesn't fit a table this button-dense, so this stays a
     plain Bootstrap panel/table instead (judgment call - see conversion
     notes). -->
<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("Index", "Menus")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
            <a asp-action="Create" class="btn btn-xs btn-icon btn-circle btn-default"><i class="fa fa-plus"></i></a>
        </div>
        <h4 class="panel-title">Sidebar items</h4>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered table-condensed">
                <thead>
                    <tr>
                        <th>Label</th>
                        <th>URL</th>
                        <th>Sort</th>
                        <th>Status</th>
                        @foreach (var role in MenuIndexViewModel.Roles)
                        {
                            <th style="text-align:center;">@role</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="@(item.ParentMenuId != null ? "padding-left:28px;" : "")">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    <i class="fa @item.Icon text-muted m-r-5"></i>
                                }
                                @item.Label
                            </td>
                            <td class="text-muted">@(item.Url ?? "(group header)")</td>
                            <td>@item.SortOrder</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="label label-success">Active</span>
                                }
                                else
                                {
                                    <span class="label label-danger">Inactive</span>
                                }
                            </td>
                            @foreach (var role in MenuIndexViewModel.Roles)
                            {
                                var granted = Model.HasAccess(item.MenuId, role);
                                <td style="text-align:center;">
                                    <form asp-action="SetRoleAccess" method="post" style="display:inline;margin:0;">
                                        <input type="hidden" name="menuId" value="@item.MenuId" />
                                        <input type="hidden" name="roleCode" value="@role" />
                                        <input type="hidden" name="canAccess" value="@(granted ? "false" : "true")" />
                                        <button type="submit" class="btn btn-xs btn-icon btn-circle @(granted ? "btn-success" : "btn-default")" title="@role: click to @(granted ? "revoke" : "grant")">
                                            <i class="fa @(granted ? "fa-check" : "fa-times")"></i>
                                        </button>
                                    </form>
                                </td>
                            }
                            <td style="white-space:nowrap;">
                                <a asp-action="Edit" asp-route-id="@item.MenuId" class="btn btn-default btn-xs"><i class="fa fa-pencil-alt"></i> Edit</a>
                                <form asp-action="ToggleStatus" method="post" style="display:inline;margin:0;">
                                    <input type="hidden" name="id" value="@item.MenuId" />
                                    <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                                    <button type="submit" class="btn btn-default btn-xs">@(item.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="@(5 + MenuIndexViewModel.Roles.Length)">
                                <p class="text-muted" style="margin:0;">No menu items yet - add the first one to start building out the sidebar.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- end panel-body -->
</div>
<!-- end panel -->

