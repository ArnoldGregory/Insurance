@model MenuFormViewModel
@{
    ViewData["Title"] = "Edit menu item";
}

<!-- begin page-header -->
<h1 class="page-header"><i class="fas fa-pencil-alt"></i> Edit menu item <small>A menu item's parent can't be changed here - delete-and-recreate under the new parent if it needs to move (see usp_Menu_Update's design note: there's no re-parent operation).</small></h1>
<!-- end page-header -->

<div class="panel panel-inverse" style="max-width:560px;">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a asp-action="Index" class="btn btn-xs btn-icon btn-circle btn-default"><i class="fa fa-arrow-left"></i></a>
        </div>
        <h4 class="panel-title">Menu item details</h4>
    </div>
    <div class="panel-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MenuId" />
            <input type="hidden" asp-for="ParentMenuId" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label class="form-control-label" asp-for="Label">Label</label>
                <input class="form-control" asp-for="Label" autofocus />
                <span asp-validation-for="Label" class="field-error"></span>
            </div>

            <div class="form-group">
                <label class="form-control-label" asp-for="Icon"></label>
                <input class="form-control" asp-for="Icon" placeholder="e.g. fa-building-shield" />
            </div>

            <div class="form-group">
                <label class="form-control-label" asp-for="Url"></label>
                <input class="form-control" asp-for="Url" placeholder="e.g. /Underwriters/Index" />
            </div>

            <div class="form-group">
                <label class="form-control-label" asp-for="SortOrder">Sort order</label>
                <input class="form-control" asp-for="SortOrder" type="number" />
            </div>

            <div style="display:flex;gap:10px;margin-top:6px;">
                <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save changes</button>
                <a asp-action="Index" class="btn btn-default">Cancel</a>
            </div>
        </form>
    </div>
    <!-- end panel-body -->
</div>
<!-- end panel -->
