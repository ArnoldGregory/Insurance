@model SupportAgentsViewModel
@{
    ViewData["Title"] = "Support Agents";
}

<style>
    .sf-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.55);z-index:9999;display:none;align-items:center;justify-content:center;}
    .sf-overlay.open{display:flex;}
    .sf-dialog{background:#fff;border-radius:10px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;box-shadow:0 12px 40px rgba(0,0,0,.3);position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:10000;}
    .sf-dialog-hdr{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e5e7eb;background:#fafbfc;border-radius:10px 10px 0 0;}
    .sf-dialog-hdr h5{margin:0;font-size:16px;font-weight:700;}
    .sf-dialog-close{background:none;border:none;font-size:22px;cursor:pointer;color:#6b7280;padding:0 4px;line-height:1;}
    .sf-dialog-close:hover{color:#111;}
    .sf-dialog-body{padding:20px;}
    .sf-dialog-foot{display:flex;justify-content:flex-end;gap:8px;padding:12px 20px;border-top:1px solid #e5e7eb;}
    .sf-form{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    .sf-form-full{grid-column:1/-1;}
    .sf-field label{display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:4px;}
    .sf-field input{width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;box-sizing:border-box;}
    .sf-field input:focus{border-color:#b8960f;outline:none;box-shadow:0 0 0 2px rgba(184,150,15,.15);}
    .sf-required{color:#dc2626;}
    .sf-btn{padding:8px 18px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;border:1px solid transparent;}
    .sf-btn-primary{background:#b8960f;color:#fff;border-color:#b8960f;}
    .sf-btn-primary:hover{background:#9a7d0d;}
    .sf-btn-cancel{background:#fff;color:#374151;border-color:#d1d5db;}
    .sf-btn-cancel:hover{background:#f3f4f6;}
</style>

<!-- begin page-header -->
<h1 class="page-header">
    <i class="fas fa-headset"></i> Support Agents
    <small>Manage support staff accounts</small>
</h1>
<!-- end page-header -->

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
}

<div class="panel panel-inverse">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="@Url.Action("SupportAgents", "Staff")" class="btn btn-xs btn-icon btn-circle btn-success"><i class="fa fa-repeat"></i></a>
            <button type="button" class="btn btn-xs btn-icon btn-circle btn-default" onclick="openCreateModal()"><i class="fa fa-plus"></i></button>
        </div>
        <h4 class="panel-title">Support Agent accounts</h4>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered table-condensed">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>ID No.</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th style="width:70px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Items.OrderBy(s => s.FullName))
                    {
                        <tr>
                            <td><strong>@s.FullName</strong></td>
                            <td>@s.IdNo</td>
                            <td>@s.Phone</td>
                            <td>@(s.Email ?? "—")</td>
                            <td><span class="label @s.StatusBadgeCss">@s.Status</span></td>
                            <td>
                                <form asp-action="DeleteSupportAgent" asp-route-id="@s.UserId" method="post" data-confirm="Silently delete this Support Agent (@s.FullName)? The account will stop working immediately and vanish from every screen, though the record is kept in audit logs." style="margin:0;">
                                    <button type="submit" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6"><p class="text-muted" style="margin:0;">No support agents found.</p></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- end panel-body -->
</div>
<!-- end panel -->

<div class="sf-overlay" id="createOverlay" onclick="if(event.target===this)closeModals()">
    <div class="sf-dialog">
        <div class="sf-dialog-hdr">
            <h5><i class="fas fa-headset" style="color:var(--gold);margin-right:8px;"></i>Add Support Agent</h5>
            <button class="sf-dialog-close" onclick="closeModals()">&times;</button>
        </div>
        <form asp-action="CreateSupportAgent" method="post">
            @Html.AntiForgeryToken()
            <div class="sf-dialog-body">
                <div class="sf-form">
                    <div class="sf-field">
                        <label>ID Number <span class="sf-required">*</span></label>
                        <input type="text" name="IdNo" id="sfIdNo" required />
                    </div>
                    <div class="sf-field">
                        <label>Phone <span class="sf-required">*</span></label>
                        <input type="text" name="Phone" id="sfPhone" required />
                    </div>
                    <div class="sf-field sf-form-full">
                        <label>Full Name <span class="sf-required">*</span></label>
                        <input type="text" name="FullName" id="sfName" required />
                    </div>
                    <div class="sf-field sf-form-full">
                        <label>Email</label>
                        <input type="email" name="Email" id="sfEmail" />
                    </div>
                    <div class="sf-field sf-form-full">
                        <label>Password <span class="sf-required">*</span></label>
                        <input type="password" name="Password" id="sfPassword" required autocomplete="new-password" />
                    </div>
                </div>
            </div>
            <div class="sf-dialog-foot">
                <button type="button" class="sf-btn sf-btn-cancel" onclick="closeModals()">Cancel</button>
                <button type="submit" class="sf-btn sf-btn-primary"><i class="fas fa-save"></i> Create</button>
            </div>
        </form>
    </div>
</div>

<script>
    function closeModals() {
        document.getElementById('createOverlay').classList.remove('open');
    }

    function openCreateModal() {
        document.getElementById('sfIdNo').value = '';
        document.getElementById('sfPhone').value = '';
        document.getElementById('sfName').value = '';
        document.getElementById('sfEmail').value = '';
        document.getElementById('sfPassword').value = '';
        document.getElementById('createOverlay').classList.add('open');
    }
</script>