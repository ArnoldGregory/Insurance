@model ClientLookupViewModel
@{
    ViewData["Title"] = "Register client";
}

<!-- begin page-header -->
<h1 class="page-header"><i class="fas fa-user-plus"></i> Register client <small>Start with the ID number - if it's already on file you'll be taken straight to that record, and if not, we'll try to prefill the name/KRA PIN for you.</small></h1>
<!-- end page-header -->

<div class="panel panel-inverse" style="max-width:480px;">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a asp-action="Index" class="btn btn-xs btn-icon btn-circle btn-default"><i class="fa fa-arrow-left"></i></a>
        </div>
        <h4 class="panel-title">Look up ID number</h4>
    </div>
    <div class="panel-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label class="form-control-label" asp-for="IdNo"></label>
                <input class="form-control" asp-for="IdNo" placeholder="National ID / Passport number" autofocus />
                <span asp-validation-for="IdNo" class="field-error"></span>
            </div>

            <div style="display:flex;gap:10px;margin-top:6px;">
                <button type="submit" class="btn btn-success"><i class="fa fa-search"></i> Look up</button>
                <a asp-action="Index" class="btn btn-default">Cancel</a>
            </div>
        </form>
    </div>
    <!-- end panel-body -->
</div>
<!-- end panel -->
