@model PurchaseJourneyViewModel
@{
    ViewData["Title"] = $"Purchase Journey - {Model.Summary?.PolicyNumber ?? Model.PurchaseId.ToString()}";
    ViewData["FullWidth"] = true;
    var s = Model.Summary;
    var statusBadgeClass = s?.Status switch
    {
        "ACTIVE" => "wz-badge--success",
        "CANCELLED" => "wz-badge--error",
        _ => "wz-badge--warning"
    };
    var payBadgeClass = s?.PaymentStatus switch
    {
        "PAID" => "wz-badge--success",
        _ => "wz-badge--warning"
    };
}
@section PageStyles {
    <style>
        .pj-hero {
            background: linear-gradient(135deg, #121212 0%, #1a1a2e 100%);
            color: #fff;
            border-radius: 14px;
            padding: 28px 32px;
            margin-bottom: 24px;
            box-shadow: 0 8px 24px -8px rgba(0,0,0,.35);
        }
        .pj-hero-top {
            display: flex; align-items: flex-start; justify-content: space-between;
            flex-wrap: wrap; gap: 16px; margin-bottom: 20px;
        }
        .pj-hero-title {
            font-size: 22px; font-weight: 800; margin: 0 0 4px;
        }
        .pj-hero-sub { font-size: 13px; color: rgba(255,255,255,.6); margin: 0; }
        .pj-hero-badges { display: flex; gap: 8px; flex-wrap: wrap; }
        .pj-hero-badge {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 4px 12px; border-radius: 20px;
            font-size: 11px; font-weight: 700; letter-spacing: .3px;
            background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2);
            color: #fff;
        }
        .pj-hero-badge.success { background: rgba(16,185,129,.2); border-color: rgba(16,185,129,.4); color: #6ee7b7; }
        .pj-hero-badge.warning { background: rgba(245,158,11,.2); border-color: rgba(245,158,11,.4); color: #fcd34d; }
        .pj-hero-badge.error { background: rgba(239,68,68,.2); border-color: rgba(239,68,68,.4); color: #fca5a5; }
        .pj-hero-badge svg { width: 12px; height: 12px; }
        .pj-hero-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 0;
        }
        .pj-hero-item {
            padding: 10px 0;
            border-top: 1px solid rgba(255,255,255,.08);
        }
        .pj-hero-item:not(:last-child) { padding-right: 16px; margin-right: 16px; border-right: 1px solid rgba(255,255,255,.08); }
        .pj-hero-label {
            font-size: 10px; text-transform: uppercase; letter-spacing: .5px;
            color: rgba(255,255,255,.45); margin-bottom: 3px;
        }
        .pj-hero-value { font-size: 14px; font-weight: 600; color: #fff; }
        .pj-hero-value.gold { color: #d4af37; font-size: 18px; }

        .pj-section-title {
            font-size: 15px; font-weight: 700; color: #111827;
            margin-bottom: 16px; display: flex; align-items: center; gap: 8px;
        }
        .pj-section-title i { color: #d4af37; font-size: 16px; }

        .pj-timeline {
            position: relative;
            padding-left: 32px;
        }
        .pj-timeline::before {
            content: '';
            position: absolute;
            left: 11px;
            top: 6px;
            bottom: 6px;
            width: 2px;
            background: #e5e7eb;
        }
        .pj-tl-item {
            position: relative;
            margin-bottom: 24px;
            padding-bottom: 4px;
        }
        .pj-tl-item:last-child { margin-bottom: 0; }
        .pj-tl-dot {
            position: absolute;
            left: -32px;
            top: 3px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 3px solid #fff;
            box-shadow: 0 0 0 2px #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1;
        }
        .pj-tl-dot i { font-size: 9px; color: #fff; }
        .pj-tl-dot.green { background: #10b981; box-shadow: 0 0 0 2px #d1fae5; }
        .pj-tl-dot.blue { background: #3b82f6; box-shadow: 0 0 0 2px #dbeafe; }
        .pj-tl-dot.purple { background: #8b5cf6; box-shadow: 0 0 0 2px #ede9fe; }
        .pj-tl-dot.orange { background: #f59e0b; box-shadow: 0 0 0 2px #fef3c7; }
        .pj-tl-dot.red { background: #ef4444; box-shadow: 0 0 0 2px #fee2e2; }
        .pj-tl-dot.gold { background: #d4af37; box-shadow: 0 0 0 2px #fef3c7; }
        .pj-tl-dot.grey { background: #9ca3af; box-shadow: 0 0 0 2px #f3f4f6; }
        .pj-tl-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 14px 18px;
            transition: box-shadow .15s;
        }
        .pj-tl-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,.06); }
        .pj-tl-header {
            display: flex; align-items: center; justify-content: space-between;
            gap: 12px; margin-bottom: 6px; flex-wrap: wrap;
        }
        .pj-tl-title { font-size: 14px; font-weight: 700; color: #111827; }
        .pj-tl-time { font-size: 12px; color: #9ca3af; white-space: nowrap; }
        .pj-tl-body { font-size: 13px; color: #4b5563; line-height: 1.5; }
        .pj-tl-body-row {
            display: flex; gap: 16px; flex-wrap: wrap;
        }
        .pj-tl-body-item { display: flex; flex-direction: column; }
        .pj-tl-body-label {
            font-size: 10px; text-transform: uppercase; letter-spacing: .4px;
            color: #9ca3af; margin-bottom: 2px;
        }
        .pj-tl-body-value { font-size: 13px; font-weight: 500; color: #111827; }
        .pj-tl-badge {
            display: inline-flex; align-items: center;
            padding: 2px 8px; border-radius: 12px;
            font-size: 10px; font-weight: 700; letter-spacing: .2px;
        }
        .pj-tl-badge.success { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
        .pj-tl-badge.error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
        .pj-tl-badge.warning { background: #fffbeb; color: #92400e; border: 1px solid #fcd34d; }
        .pj-tl-badge.info { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }

        .pj-two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }
        @@media (max-width: 900px) {
            .pj-two-col { grid-template-columns: 1fr; }
            .pj-hero-item:not(:last-child) { padding-right: 0; margin-right: 0; border-right: none; }
        }
        .pj-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
        }
        .pj-card-header {
            display: flex; align-items: center; gap: 10px;
            padding: 14px 18px;
            border-bottom: 1px solid #e5e7eb;
            background: #fafbfc;
        }
        .pj-card-icon {
            width: 34px; height: 34px; border-radius: 8px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 14px;
        }
        .pj-card-icon.gold { background: rgba(212,175,55,.12); color: #d4af37; }
        .pj-card-icon.blue { background: rgba(59,130,246,.12); color: #3b82f6; }
        .pj-card-icon.purple { background: rgba(139,92,246,.12); color: #8b5cf6; }
        .pj-card-icon.green { background: rgba(16,185,129,.12); color: #10b981; }
        .pj-card-title { font-size: 14px; font-weight: 700; color: #111827; margin: 0; }
        .pj-card-body { padding: 16px 18px; }

        .pj-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 0;
        }
        .pj-info-cell {
            padding: 8px 0;
            border-bottom: 1px solid #f3f4f6;
        }
        .pj-info-cell:nth-child(odd) { padding-right: 12px; margin-right: 12px; border-right: 1px solid #f3f4f6; }
        .pj-info-label {
            font-size: 10px; text-transform: uppercase; letter-spacing: .4px;
            color: #9ca3af; margin-bottom: 2px;
        }
        .pj-info-value { font-size: 13px; font-weight: 500; color: #111827; }

        .pj-related-table { width: 100%; border-collapse: collapse; }
        .pj-related-table th {
            text-align: left; padding: 10px 14px;
            font-size: 11px; font-weight: 700; text-transform: uppercase;
            letter-spacing: .5px; color: #9ca3af; background: #fafbfc;
            border-bottom: 1px solid #e5e7eb;
        }
        .pj-related-table td {
            padding: 10px 14px; font-size: 13px; color: #111827;
            border-bottom: 1px solid #f3f4f6;
        }
        .pj-related-table tbody tr:last-child td { border-bottom: none; }
        .pj-related-table tbody tr:hover td { background: rgba(0,0,0,.02); }

        .pj-empty {
            text-align: center; padding: 32px 16px;
            color: #9ca3af; font-size: 13px;
        }
        .pj-empty i { font-size: 24px; margin-bottom: 8px; display: block; opacity: .4; }
    </style>
}

<div style="margin-bottom: 16px;">
    <a asp-action="Index" class="wz-btn wz-btn--ghost wz-btn--sm">
        <i class="fa fa-arrow-left"></i> Back to Purchases
    </a>
</div>

@if (s != null)
{
    <div class="pj-hero">
        <div class="pj-hero-top">
            <div>
                <h1 class="pj-hero-title">
                    <i class="fa fa-route" style="margin-right:8px;font-size:18px;"></i>@(s.PolicyNumber ?? $"Purchase #{Model.PurchaseId}")
                </h1>
                <p class="pj-hero-sub">@(s.ProductName ?? s.ProductCode) &middot; @(s.UnderwriterName ?? "N/A")</p>
            </div>
            <div class="pj-hero-badges">
                <span class="pj-hero-badge @(statusBadgeClass == "wz-badge--success" ? "success" : statusBadgeClass == "wz-badge--error" ? "error" : "warning")">
                    <i class="fa fa-circle" style="font-size:6px;"></i> @(s.Status ?? "UNKNOWN")
                </span>
                <span class="pj-hero-badge @(payBadgeClass == "wz-badge--success" ? "success" : "warning")">
                    <i class="fa fa-credit-card" style="font-size:10px;"></i> @(s.PaymentStatus ?? "UNKNOWN")
                </span>
            </div>
        </div>
        <div class="pj-hero-grid">
            <div class="pj-hero-item">
                <div class="pj-hero-label">Premium</div>
                <div class="pj-hero-value gold">@s.PremiumAmount.ToString("N2")</div>
            </div>
            <div class="pj-hero-item">
                <div class="pj-hero-label">Client</div>
                <div class="pj-hero-value">@s.ClientName</div>
            </div>
            <div class="pj-hero-item">
                <div class="pj-hero-label">ID No.</div>
                <div class="pj-hero-value">@(s.ClientIdNo ?? "—")</div>
            </div>
            <div class="pj-hero-item">
                <div class="pj-hero-label">Phone</div>
                <div class="pj-hero-value">@(s.ClientPhone ?? "—")</div>
            </div>
            <div class="pj-hero-item">
                <div class="pj-hero-label">Email</div>
                <div class="pj-hero-value" style="font-size:12px;">@(s.ClientEmail ?? "—")</div>
            </div>
            <div class="pj-hero-item">
                <div class="pj-hero-label">Created By</div>
                <div class="pj-hero-value">@(s.CreatedByName ?? "—")</div>
            </div>
            <div class="pj-hero-item">
                <div class="pj-hero-label">Created On</div>
                <div class="pj-hero-value">@s.CreatedOn.ToString("dd MMM yyyy, HH:mm")</div>
            </div>
            @if (s.StartDate.HasValue && s.EndDate.HasValue)
            {
                <div class="pj-hero-item">
                    <div class="pj-hero-label">Policy Period</div>
                    <div class="pj-hero-value" style="font-size:12px;">@s.StartDate.Value.ToString("dd MMM yyyy") &ndash; @s.EndDate.Value.ToString("dd MMM yyyy")</div>
                </div>
            }
        </div>
    </div>
}

<div class="pj-two-col">
    <div>
        <div class="pj-section-title"><i class="fa fa-stream"></i> Event Timeline</div>
        <div class="pj-timeline">
            @if (!Model.Timeline.Any())
            {
                <div class="pj-empty">
                    <i class="fa fa-clock"></i>
                    No timeline events recorded yet.
                </div>
            }
            @foreach (var ev in Model.Timeline.OrderBy(e => e.StepOrder).ThenBy(e => e.EventTime))
            {
                var (dotClass, iconClass, label) = ev.EventType switch
                {
                    "PURCHASE_SUMMARY" => ("green", "fa-check", "Purchase Created"),
                    "MPESA" => ("blue", "fa-mobile-alt", "M-Pesa Payment"),
                    "PENDING" => ("orange", "fa-hourglass-half", "Payment Pending"),
                    "SUCCESS" => ("green", "fa-check-circle", "Payment Successful"),
                    "FAILED" => ("red", "fa-times-circle", "Payment Failed"),
                    "VEHICLE" => ("purple", "fa-car", "Vehicle Captured"),
                    "CREATE" => ("green", "fa-plus-circle", "Record Created"),
                    "UPDATE" => ("blue", "fa-edit", "Record Updated"),
                    "STATUS_CHANGE" => ("orange", "fa-exchange-alt", "Status Changed"),
                    "ASSIGN" => ("purple", "fa-user-plus", "Assigned"),
                    "OTP_VERIFIED" => ("green", "fa-shield-alt", "OTP Verified"),
                    "RELATED_PURCHASE" => ("gold", "fa-link", "Related Purchase"),
                    _ => ("grey", "fa-info-circle", ev.EventType)
                };

                var eventData = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(ev.EventDataJson) ?? new();

                <div class="pj-tl-item">
                    <div class="pj-tl-dot @dotClass"><i class="fas @iconClass"></i></div>
                    <div class="pj-tl-card">
                        <div class="pj-tl-header">
                            <span class="pj-tl-title">@label</span>
                            <span class="pj-tl-time"><i class="fa fa-clock" style="margin-right:4px;"></i>@ev.EventTime.ToString("dd MMM yyyy, HH:mm:ss")</span>
                        </div>
                        <div class="pj-tl-body">
                            @{
                                if (ev.EventType == "PURCHASE_SUMMARY")
                                {
                                    <div class="pj-tl-body-row">
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Policy Number</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("policy_number")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Product</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("product_name")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Premium</span>
                                            <span class="pj-tl-body-value">@eventData.GetDecimal("premium_amount").ToString("N2")</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Client</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("client_name")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Created By</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("created_by_name")))</span>
                                        </div>
                                    </div>
                                }
                                else if (ev.EventType is "MPESA" or "PENDING" or "SUCCESS" or "FAILED")
                                {
                                    <div class="pj-tl-body-row">
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Amount</span>
                                            <span class="pj-tl-body-value">@eventData.GetDecimal("amount").ToString("N2")</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Method</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("method")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Phone</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("payer_phone")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Transaction Ref</span>
                                            <span class="pj-tl-body-value" style="font-family:monospace;">@((eventData.GetString("transaction_reference")))</span>
                                        </div>
                                        @if (ev.EventType is "SUCCESS" or "FAILED")
                                        {
                                            <div class="pj-tl-body-item">
                                                <span class="pj-tl-body-label">Status</span>
                                                <span class="pj-tl-badge @(ev.EventType == "SUCCESS" ? "success" : "error")">@(eventData.GetString("status"))</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (ev.EventType == "VEHICLE")
                                {
                                    <div class="pj-tl-body-row">
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Make</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("make")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Model</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("model")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Reg No.</span>
                                            <span class="pj-tl-body-value" style="font-family:monospace;">@((eventData.GetString("reg_no")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Chassis No.</span>
                                            <span class="pj-tl-body-value" style="font-family:monospace;">@((eventData.GetString("chassis_no")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Year</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("yearofmanufacture")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Value</span>
                                            <span class="pj-tl-body-value">@eventData.GetDecimal("vehicle_value").ToString("N2")</span>
                                        </div>
                                    </div>
                                }
                                else if (ev.EventType is "CREATE" or "UPDATE" or "STATUS_CHANGE" or "ASSIGN" or "OTP_VERIFIED")
                                {
                                    <div class="pj-tl-body-row">
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Actor</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("actor_type")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Action</span>
                                            <span class="pj-tl-badge info">@((eventData.GetString("action")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Entity</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("entity")))</span>
                                        </div>
                                        @if (eventData.ContainsKey("new_value") || eventData.ContainsKey("old_value"))
                                        {
                                            <div class="pj-tl-body-item">
                                                <span class="pj-tl-body-label">From</span>
                                                <span class="pj-tl-body-value">@((eventData.GetString("old_value")))</span>
                                            </div>
                                            <div class="pj-tl-body-item">
                                                <span class="pj-tl-body-label">To</span>
                                                <span class="pj-tl-body-value">@((eventData.GetString("new_value")))</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (ev.EventType == "RELATED_PURCHASE")
                                {
                                    <div class="pj-tl-body-row">
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Related Purchase ID</span>
                                            <span class="pj-tl-body-value">#@eventData.GetLong("purchase_id")</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Policy Number</span>
                                            <span class="pj-tl-body-value">@((eventData.GetString("policy_number")))</span>
                                        </div>
                                        <div class="pj-tl-body-item">
                                            <span class="pj-tl-body-label">Premium</span>
                                            <span class="pj-tl-body-value">@eventData.GetDecimal("premium_amount").ToString("N2")</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div style="font-size:12px;color:#6b7280;font-family:monospace;word-break:break-all;">
                                        @ev.EventDataJson
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div>
        @if (Model.Payments.Any())
        {
            <div class="pj-section-title"><i class="fa fa-credit-card"></i> Payments</div>
            @foreach (var p in Model.Payments)
            {
                var pBadge = p.Status?.ToUpper() switch
                {
                    "SUCCESS" or "PAID" => "success",
                    "FAILED" => "error",
                    _ => "warning"
                };
                <div class="pj-card" style="margin-bottom:16px;">
                    <div class="pj-card-header">
                        <div class="pj-card-icon blue"><i class="fas fa-money-check-alt"></i></div>
                        <div style="flex:1;">
                            <div class="pj-card-title">KES @p.Amount.ToString("N2") via @p.Method</div>
                        </div>
                        <span class="pj-tl-badge @pBadge">@p.Status</span>
                    </div>
                    <div class="pj-card-body">
                        <div class="pj-info-grid">
                            <div class="pj-info-cell">
                                <div class="pj-info-label">Payer Phone</div>
                                <div class="pj-info-value">@(p.PayerPhone ?? "—")</div>
                            </div>
                            <div class="pj-info-cell">
                                <div class="pj-info-label">Transaction Ref</div>
                                <div class="pj-info-value" style="font-family:monospace;font-size:12px;">@(p.TransactionReference ?? "—")</div>
                            </div>
                            <div class="pj-info-cell">
                                <div class="pj-info-label">Initiated</div>
                                <div class="pj-info-value">@p.InitiatedOn.ToString("dd MMM, HH:mm")</div>
                            </div>
                            <div class="pj-info-cell">
                                <div class="pj-info-label">Completed</div>
                                <div class="pj-info-value">@(p.CompletedOn?.ToString("dd MMM, HH:mm") ?? "—")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        @if (Model.Vehicle != null)
        {
            <div class="pj-section-title"><i class="fa fa-car"></i> Vehicle</div>
            <div class="pj-card" style="margin-bottom:16px;">
                <div class="pj-card-header">
                    <div class="pj-card-icon purple"><i class="fas fa-car"></i></div>
                    <div class="pj-card-title">@(Model.Vehicle.Make) @(Model.Vehicle.Model)</div>
                </div>
                <div class="pj-card-body">
                    <div class="pj-info-grid">
                        <div class="pj-info-cell">
                            <div class="pj-info-label">Reg No.</div>
                            <div class="pj-info-value" style="font-family:monospace;">@(Model.Vehicle.RegNo ?? "—")</div>
                        </div>
                        <div class="pj-info-cell">
                            <div class="pj-info-label">Chassis No.</div>
                            <div class="pj-info-value" style="font-family:monospace;font-size:12px;">@(Model.Vehicle.ChassisNo ?? "—")</div>
                        </div>
                        <div class="pj-info-cell">
                            <div class="pj-info-label">Year</div>
                            <div class="pj-info-value">@(Model.Vehicle.YearOfManufacture?.ToString() ?? "—")</div>
                        </div>
                        <div class="pj-info-cell">
                            <div class="pj-info-label">Value</div>
                            <div class="pj-info-value">@(Model.Vehicle.VehicleValue?.ToString("N2") ?? "—")</div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.RelatedPurchases.Any())
        {
            <div class="pj-section-title"><i class="fa fa-link"></i> Related Purchases</div>
            <div class="pj-card">
                <div class="pj-card-body" style="padding:0;">
                    <table class="pj-related-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Policy No.</th>
                                <th>Premium</th>
                                <th>Status</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rp in Model.RelatedPurchases)
                            {
                                var rpStatusClass = rp.Status switch
                                {
                                    "ACTIVE" => "success",
                                    "CANCELLED" => "error",
                                    _ => "warning"
                                };
                                <tr>
                                    <td><a asp-action="Journey" asp-route-id="@rp.PurchaseId" style="font-weight:600;">#@rp.PurchaseId</a></td>
                                    <td style="font-family:monospace;font-size:12px;">@(rp.PolicyNumber ?? "—")</td>
                                    <td>@rp.PremiumAmount.ToString("N2")</td>
                                    <td><span class="pj-tl-badge @rpStatusClass">@rp.Status</span></td>
                                    <td>@rp.CreatedOn.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
