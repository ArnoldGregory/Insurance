@model PurchaseDetail
@{
    ViewData["Title"] = $"Certificate - Policy {Model.PolicyNumber ?? Model.PurchaseId.ToString()}";
    ViewData["FullWidth"] = true;
    var vehicle = Model.VehicleSnapshot;
}
@section PageStyles {
    <style>
        @@page { size: A4; margin: 14mm; }

        .cert-toolbar {
            display: flex; justify-content: space-between; align-items: center;
            gap: 12px; margin-bottom: 20px; flex-wrap: wrap;
        }
        .cert-toolbar h1 { font-size: 20px; font-weight: 800; margin: 0; color: #111827; }
        .cert-toolbar .actions { display: flex; gap: 10px; }

        .cert-sheet {
            background: #fff;
            max-width: 820px;
            margin: 0 auto;
            border: 2px solid #d4af37;
            border-radius: 10px;
            padding: 36px 40px;
            position: relative;
            color: #111827;
        }
        .cert-sheet::before {
            content: '';
            position: absolute; inset: 8px;
            border: 1px solid #e5e7eb; border-radius: 6px; pointer-events: none;
        }

        .cert-header {
            text-align: center; padding-bottom: 20px; border-bottom: 2px solid #d4af37; margin-bottom: 22px;
        }
        .cert-brand { font-size: 22px; font-weight: 800; letter-spacing: 1px; color: #1a1a2e; }
        .cert-brand span { color: #d4af37; }
        .cert-title { font-size: 16px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: #4b5563; margin-top: 4px; }

        .cert-no-row {
            display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
            margin-bottom: 22px; align-items: baseline;
        }
        .cert-no-box { font-family: monospace; font-size: 15px; font-weight: 700; background: #faf9ef; border: 1px dashed #d4af37; padding: 8px 14px; border-radius: 6px; }
        .cert-issued { font-size: 12px; color: #6b7280; }

        .cert-section-title {
            font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px;
            color: #9ca3af; margin: 18px 0 8px;
        }

        .cert-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 4px 24px;
        }
        .cert-item { padding: 8px 0; border-bottom: 1px solid #f3f4f6; }
        .cert-label { font-size: 10px; text-transform: uppercase; letter-spacing: .5px; color: #9ca3af; margin-bottom: 2px; }
        .cert-value { font-size: 14px; font-weight: 600; color: #111827; }
        .cert-value.gold { color: #b8860b; font-size: 18px; }

        .cert-hr { border: 0; border-top: 1px solid #e5e7eb; margin: 18px 0; }

        .cert-footer {
            margin-top: 24px; padding-top: 16px; border-top: 2px solid #d4af37;
            display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
            font-size: 11px; color: #6b7280;
        }
        .cert-stamp { font-style: italic; color: #9ca3af; }

        @@media print {
            .cert-toolbar, .noprint { display: none !important; }
            body { background: #fff; }
            .cert-sheet { border-color: #000; box-shadow: none; max-width: 100%; }
            .cert-sheet::before { border-color: #9ca3af; }
            .cert-brand span { color: #000; }
        }
    </style>
}

<div class="cert-toolbar">
    <h1><i class="fa fa-award" style="color:#d4af37;margin-right:8px;"></i>Policy Certificate</h1>
    <div class="actions no-print">
        <a asp-action="Details" asp-route-id="@Model.PurchaseId" class="wz-btn wz-btn--ghost wz-btn--sm"><i class="fa fa-arrow-left"></i> Back</a>
        <button type="button" class="wz-btn wz-btn--gold wz-btn--sm" onclick="window.print()"><i class="fa fa-print"></i> Print / Save PDF</button>
    </div>
</div>

<div class="cert-sheet">
    <div class="cert-header">
        <div class="cert-brand">Riziki<span>Cover</span></div>
        <div class="cert-title">Insurance Certificate</div>
    </div>

    <div class="cert-no-row">
        <div>
            <div class="cert-label">Certificate Number</div>
            <div class="cert-no-box">@(Model.CertificateNumber ?? "—")</div>
        </div>
        <div class="cert-issued">
            Issued @(Model.CertificateGeneratedOn?.ToString("dd MMM yyyy, HH:mm") ?? "—")<br />
            Payment status: <strong>@Model.PaymentStatus</strong>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.NtsaCertificateNo))
    {
        <div class="cert-grid">
            <div class="cert-item">
                <div class="cert-label">Official NTSA Certificate No.</div>
                <div class="cert-value" style="font-family:monospace;">@Model.NtsaCertificateNo</div>
            </div>
            <div class="cert-item">
                <div class="cert-label">NTSA Transaction Ref</div>
                <div class="cert-value" style="font-family:monospace;">@(Model.NtsaTransactionNo ?? "—")</div>
            </div>
            <div class="cert-item">
                <div class="cert-label">NTSA Issued On</div>
                <div class="cert-value">@(Model.NtsaIssuedOn?.ToString("dd MMM yyyy, HH:mm") ?? "—")</div>
            </div>
            <div class="cert-item">
                <div class="cert-label">Official document</div>
                <div class="cert-value"><a asp-action="NtsaDocument" asp-route-id="@Model.PurchaseId" target="_blank"><i class="fa fa-external-link"></i> View stored NTSA response</a></div>
            </div>
        </div>
        <hr class="cert-hr" />
    }

    <div class="cert-section-title">Insured</div>
    <div class="cert-grid">
        <div class="cert-item"><div class="cert-label">Full name</div><div class="cert-value">@(Model.ClientName ?? "—")</div></div>
        <div class="cert-item"><div class="cert-label">ID / Passport No.</div><div class="cert-value">@(Model.ClientIdNo ?? "—")</div></div>
        <div class="cert-item"><div class="cert-label">Phone</div><div class="cert-value">@(Model.ClientPhone ?? "—")</div></div>
        <div class="cert-item"><div class="cert-label">Email</div><div class="cert-value">@(Model.ClientEmail ?? "—")</div></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.VehicleRegNo))
    {
        <div class="cert-section-title">Insured Vehicle</div>
        <div class="cert-grid">
            <div class="cert-item"><div class="cert-label">Registration No.</div><div class="cert-value" style="font-family:monospace;">@Model.VehicleRegNo</div></div>
            <div class="cert-item"><div class="cert-label">Make / Model</div><div class="cert-value">@($"{Model.VehicleMake} {Model.VehicleModel}".Trim())</div></div>
            @if (vehicle?.VehicleValue is not null)
            {
                <div class="cert-item"><div class="cert-label">Vehicle Value</div><div class="cert-value">@vehicle.VehicleValue.Value.ToString("N2")</div></div>
            }
            @if (vehicle?.LicensedToCarry is not null)
            {
                <div class="cert-item"><div class="cert-label">Licensed To Carry</div><div class="cert-value">@vehicle.LicensedToCarry</div></div>
            }
        </div>
    }

    <hr class="cert-hr" />

    <div class="cert-section-title">Policy Details</div>
    <div class="cert-grid">
        <div class="cert-item"><div class="cert-label">Policy Number</div><div class="cert-value" style="font-family:monospace;">@(Model.PolicyNumber ?? "—")</div></div>
        <div class="cert-item"><div class="cert-label">Product</div><div class="cert-value">@(Model.ProductName ?? Model.ProductCode)</div></div>
        <div class="cert-item"><div class="cert-label">Underwriter</div><div class="cert-value">@Model.UnderwriterName</div></div>
        <div class="cert-item"><div class="cert-label">Period</div><div class="cert-value">@Model.PeriodName</div></div>
        <div class="cert-item"><div class="cert-label">Cover Start</div><div class="cert-value">@Model.StartDate.ToString("dd MMM yyyy")</div></div>
        <div class="cert-item"><div class="cert-label">Cover End</div><div class="cert-value">@Model.EndDate.ToString("dd MMM yyyy")</div></div>
        <div class="cert-item"><div class="cert-label">Premium Paid</div><div class="cert-value gold">KES @Model.PremiumAmount.ToString("N2")</div></div>
        <div class="cert-item"><div class="cert-label">Purchase Ref</div><div class="cert-value">#@Model.PurchaseId</div></div>
    </div>

    <div class="cert-footer">
        <span>This certificate confirms the insurance cover described above and is issued subject to the policy terms, conditions and exclusions.</span>
        <span class="cert-stamp">Issued by RizikiCover · insuranceapi.riziki.app</span>
    </div>
</div>