<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="${basedir}/logs/nlog-internal.log">

  <!-- Two targets: "f" (the daily file - the permanent record) and "console"
       (stdout - just for live feedback while running locally with `dotnet run`).
       This does not violate "everything in one place": the file is still the
       single source of truth. Console is a throwaway mirror of it, useful only
       while you're staring at the terminal. Every logger in the app -
       controllers, services, repositories, the stored-proc executor - writes
       to both. Requests are told apart inside the file by the [Ref]
       correlation reference that CorrelationMiddleware pushes into NLog's
       ScopeContext for the lifetime of each request. Grep the file for a
       given ref to see that request's entire flow, in order, across every
       layer it touched. -->

  <targets>
    <target xsi:type="File" name="f" fileName="${basedir}/logs/${shortdate}.log"
            layout="${longdate} ${uppercase:${level}} [${scopeproperty:item=Ref}] ${message} ${exception:format=tostring}" />
    <target xsi:type="Console" name="console"
            layout="${longdate} ${uppercase:${level}} [${scopeproperty:item=Ref}] ${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <!-- Microsoft.Hosting.Lifetime is the specific logger ASP.NET Core uses
         for "Now listening on...", "Application started.", and
         "Application is shutting down." - the handful of messages that
         confirm the server is actually alive. It happens to start with
         "Microsoft." like the framework noise below, so it must be carved
         out and allowed through BEFORE the general Microsoft.* suppression
         rule, or it gets caught and dropped by that rule instead - which is
         exactly what silently happened before this fix. -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="f,console" final="true" />

    <!-- Everything else under Microsoft.* / System.Net.Http.* (routing,
         Kestrel connection noise, HTTP client internals) floods Info/Debug
         with things that aren't useful when tracing one request's business
         logic. Cap it at Warning and stop it there (final="true") so it
         never falls through to the catch-all rule below and duplicates. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Debug" writeTo="f,console" />
  </rules>
</nlog>
